# macOS Finder cruft
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# Hugo build output
/public/
/resources/_gen/
.hugo_build.lock

# _vendor/ is intentionally committed: it pins the Congo theme so builds
# never depend on the Go module proxy. Refresh with `hugo mod vendor`.
/vendor/

# Go / Hugo module files
*.log
*.tmp

# Node/npm (if you ever use PostCSS/Tailwind locally)
node_modules/
package-lock.json
yarn.lock

# IDE/editor settings - share the F5 preview config, ignore personal prefs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Python venv (if you run helpers)
.venv/
__pycache__/
*.pyc

# GitHub Pages Action cache
hugo_cache/